# Copy to terraform.tfvars (gitignored) and fill in. Everything else in
# variables.tf has a workable default.

# Your own IP, /32 -- never leave this as 0.0.0.0/0.
ssh_ingress_cidr = "203.0.113.4/32"

# Name of an EC2 key pair that already exists in this AWS account/region.
ssh_key_name = "your-ec2-key-pair-name"
