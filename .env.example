# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=testgen
POSTGRES_USER=testgen
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg://testgen:changeme@localhost:5432/testgen

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Milvus ---
MILVUS_URI=./data/milvus_lite.db

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_PRO=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Jira (live) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# --- Azure DevOps (no live tenant -- contract-tested only, see docs/PROGRESS.md) ---
ADO_ORGANIZATION=
ADO_PROJECT=
ADO_PAT=

# --- Polarion (no live tenant -- contract-tested only, see docs/PROGRESS.md) ---
POLARION_BASE_URL=
POLARION_PROJECT_ID=
POLARION_TOKEN=

# --- Object storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
S3_BUCKET=
AWS_REGION=

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=
